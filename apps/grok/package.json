{
  "name": "grok-quota-mac",
  "version": "1.3.2",
  "description": "macOS Grok 額度圓球面板，即時顯示 Grok Context Window 上下文空間與 Session 消耗用量。",
  "main": "src/main/main.js",
  "author": "michelle0812 and Grok Quota Widget contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/michelle0812/claude-codex-quota-mac.git"
  },
  "homepage": "https://github.com/michelle0812/claude-codex-quota-mac#readme",
  "bugs": {
    "url": "https://github.com/michelle0812/claude-codex-quota-mac/issues"
  },
  "keywords": [
    "grok",
    "xai",
    "grok-quota",
    "usage-widget",
    "rate-limit",
    "desktop-widget",
    "electron",
    "macos-widget",
    "grok用量",
    "grok額度"
  ],
  "scripts": {
    "sync-shared": "node ../../scripts/sync-shared.js",
    "heal-electron": "node ../../scripts/heal-electron.js apps/grok",
    "postinstall": "npm run sync-shared && npm run heal-electron",
    "prestart": "npm run sync-shared && npm run heal-electron",
    "predev": "npm run sync-shared && npm run heal-electron",
    "prebuild": "npm run sync-shared",
    "prebuild:dir": "npm run sync-shared",
    "pretest": "npm run sync-shared",
    "dev": "electron .",
    "start": "electron .",
    "test:pace": "node scripts/verify-pace-advice.js",
    "test:quota-store": "node scripts/verify-quota-store.js",
    "test:widget-settings": "node scripts/verify-widget-settings.js",
    "test:app-config": "node scripts/verify-app-config.js",
    "test:preload": "node scripts/verify-preload.js",
    "test:profiles": "node scripts/verify-profiles.js",
    "test:update-check": "node scripts/verify-update-check.js",
    "test:mac-updater": "node ../../packages/build-scripts/verify-mac-updater.js",
    "test:grok-service": "node scripts/verify-grok-service.js",
    "test:grok-oauth": "node scripts/verify-grok-oauth.js",
    "test": "npm run test:pace && npm run test:quota-store && npm run test:profiles && npm run test:widget-settings && npm run test:app-config && npm run test:preload && npm run test:update-check && npm run test:mac-updater && npm run test:grok-service && npm run test:grok-oauth",
    "build": "npm run build:arm64 && npm run build:x64",
    "build:dir": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "build:arm64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "build:x64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64",
    "prebuild:arm64": "npm run sync-shared",
    "prebuild:x64": "npm run sync-shared"
  },
  "build": {
    "appId": "ai.x.grok.quota.widget",
    "productName": "Grok 額度",
    "afterPack": "scripts/after-pack-macos.js",
    "afterAllArtifactBuild": "scripts/after-all-artifact-build.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/app-icon.png",
      "assets/app-icon-tray-16.png",
      "assets/app-icon-256.png",
      "package.json"
    ],
    "mac": {
      "icon": "assets/app-icon.png",
      "target": [
        "dmg"
      ],
      "artifactName": "GrokQuota-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
